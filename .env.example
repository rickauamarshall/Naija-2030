# Copy this file to .env and fill in real values. Never commit .env — see
# CLAUDE.md's hard rules. Secrets are environment-only, always.

# --- X (Twitter) API v2 (posting the match-day feed + recaps + issue threads) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- beehiiv (publishing issue drafts via server/src/jobs/publishIssueCli.js) ---
# Get these from beehiiv: Settings -> Integrations -> API. Posts are always
# created as drafts (see beehiivClient.js) - a human still has to hit send.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- Match-stats provider for server/ (the tweet feed) ---
# "mock" is the only wired-up value today — see CLAUDE.md "Data vendor
# decisions" before picking a real provider and implementing it in
# server/src/providers/.
STATS_PROVIDER=mock
STATS_API_KEY=

# --- Eligibility classification pipeline (scripts/classify_eligibility.py) ---
ANTHROPIC_API_KEY=
